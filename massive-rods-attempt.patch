+    - 2 * b1r * r1 * dtheta1
+    - 8 * b2b * r1 * dtheta1
+    - 8 * b2b * r2 * cosDelta * dtheta2
+    + 8 * b2b * sinDelta * dr2
+    - 8 * b2r * r1 * dtheta1
+    - 4 * b2r * r2 * cosDelta * dtheta2
+    + 4 * b2r * sinDelta * dr2
