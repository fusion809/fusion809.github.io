+    - 2 * b2r * r2 * dtheta2
+    - 4 * b2r * sinDelta * dr1
+    + 8 * c2b * sqrtV2 * r1 * cosDelta * dtheta1
+    + 8 * c2b * sqrtV2 * r2 * dtheta2
+    + 8 * c2b * sqrtV2 * sinDelta * dr1
+    + 2 * c2r * sqrtV3 * r1 * cosDelta * dtheta1
